{
	"manifest_version": 3,
	"name": "Do Not Disturb — Focus Guard",
	"version": "1.0.0",
	"description": "Companion browser extension for Do Not Disturb to deflect distracting websites during focus sessions.",
	"permissions": ["declarativeNetRequest", "storage", "alarms", "tabs"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Do Not Disturb",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"content_scripts": [
		{
			"matches": [
				"http://localhost:3000/*",
				"http://localhost:3001/*",
				"http://localhost:3002/*",
				"http://localhost:3003/*",
				"http://localhost:3004/*",
				"http://localhost:3005/*",
				"http://localhost:3006/*",
				"http://localhost:3007/*",
				"http://localhost:3008/*",
				"http://localhost:3009/*",
				"http://localhost:3010/*",
				"http://localhost:5173/*",
				"http://localhost:4173/*",
				"http://localhost:8080/*",
				"http://127.0.0.1:3000/*",
				"http://127.0.0.1:3001/*",
				"http://127.0.0.1:3002/*",
				"http://127.0.0.1:3003/*",
				"http://127.0.0.1:3004/*",
				"http://127.0.0.1:3005/*",
				"http://127.0.0.1:3006/*",
				"http://127.0.0.1:3007/*",
				"http://127.0.0.1:3008/*",
				"http://127.0.0.1:3009/*",
				"http://127.0.0.1:3010/*",
				"http://127.0.0.1:5173/*",
				"http://127.0.0.1:4173/*",
				"http://127.0.0.1:8080/*",
				"https://do-not-disturb.vercel.app/*",
				"http://do-not-disturb.vercel.app/*",
				"https://donotdistrb.com/*",
				"https://www.donotdistrb.com/*",
				"http://donotdistrb.com/*",
				"http://www.donotdistrb.com/*",
				"https://*.donotdistrb.com/*",
				"http://*.donotdistrb.com/*",
				"https://donotdisturb.com/*",
				"https://www.donotdisturb.com/*",
				"http://donotdisturb.com/*",
				"http://www.donotdisturb.com/*",
				"https://*.donotdisturb.com/*",
				"http://*.donotdisturb.com/*"
			],
			"js": ["content.js"],
			"run_at": "document_start"
		}
	],
	"externally_connectable": {
		"matches": [
			"http://localhost:3000/*",
			"http://localhost:3001/*",
			"http://localhost:3002/*",
			"http://localhost:3003/*",
			"http://localhost:3004/*",
			"http://localhost:3005/*",
			"http://localhost:3006/*",
			"http://localhost:3007/*",
			"http://localhost:3008/*",
			"http://localhost:3009/*",
			"http://localhost:3010/*",
			"http://localhost:5173/*",
			"http://localhost:4173/*",
			"http://localhost:8080/*",
			"http://127.0.0.1:3000/*",
			"http://127.0.0.1:3001/*",
			"http://127.0.0.1:3002/*",
			"http://127.0.0.1:3003/*",
			"http://127.0.0.1:3004/*",
			"http://127.0.0.1:3005/*",
			"http://127.0.0.1:3006/*",
			"http://127.0.0.1:3007/*",
			"http://127.0.0.1:3008/*",
			"http://127.0.0.1:3009/*",
			"http://127.0.0.1:3010/*",
			"http://127.0.0.1:5173/*",
			"http://127.0.0.1:4173/*",
			"http://127.0.0.1:8080/*",
			"https://do-not-disturb.vercel.app/*",
			"http://do-not-disturb.vercel.app/*",
			"https://donotdistrb.com/*",
			"https://www.donotdistrb.com/*",
			"http://donotdistrb.com/*",
			"http://www.donotdistrb.com/*",
			"https://*.donotdistrb.com/*",
			"http://*.donotdistrb.com/*",
			"https://donotdisturb.com/*",
			"https://www.donotdisturb.com/*",
			"http://donotdisturb.com/*",
			"http://www.donotdisturb.com/*",
			"https://*.donotdisturb.com/*",
			"http://*.donotdisturb.com/*"
		]
	},
	"web_accessible_resources": [
		{
			"resources": ["blocked.html", "icons/*"],
			"matches": ["<all_urls>"]
		}
	]
}
